<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/arctrack_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
        <item name="android:statusBarColor">@color/arctrack_background</item>
        <item name="android:navigationBarColor">@color/arctrack_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/arctrack_background</item>
        <item name="android:statusBarColor">@color/arctrack_background</item>
        <item name="android:navigationBarColor">@color/arctrack_background</item>
    </style>
</resources>
